*.tfstate
*.tfstate.*
.terraform/

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# Figures (regenerateable)
figures/
figures/*.png
figures/*.pdf
figures/*.svg

# Coverage
htmlcov/
.coverage
.pytest_cache/
pytest-cache-files-*/

# Chaincode binaries
chaincode/agentecon
chaincode/agentecon.exe

