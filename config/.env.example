# AgentEcon Environment Variables Template
# Copy this file to .env and fill in your values

# Hugging Face API Token (required for model downloads)
# HF_TOKEN=your_hugging_face_token_here

# EIA API Key (optional, for WTI oil data)
# EIA_API_KEY=your_eia_api_key_here

# FRED API Key (optional, for Case-Shiller data)
# FRED_API_KEY=your_fred_api_key_here

# AWS Credentials (for Fabric WAN deployment)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1

# Weights & Biases (optional, for experiment tracking)
# WANDB_API_KEY=your_wandb_key
# WANDB_PROJECT=agentecon_replication

# vLLM Settings
# VLLM_TENSOR_PARALLEL_SIZE=1
# VLLM_GPU_MEMORY_UTILIZATION=0.9
# VLLM_MAX_MODEL_LEN=4096

# Experiment Settings
# EXPERIMENT_MODE=stylised  # 'llm', 'stylised', or 'mixed'
# LOG_LEVEL=INFO
